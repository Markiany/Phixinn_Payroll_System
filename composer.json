{
    "name": "company/attendance-payroll-system",
    "description": "Employee Attendance and Payroll Management System (NGTeco + Google Sheets)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "firebase/php-jwt": "^6.10",
        "google/apiclient": "^2.16",
        "phpoffice/phpspreadsheet": "^2.1",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
"config": {
        "optimize-autoloader": false,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public"
    }
}
